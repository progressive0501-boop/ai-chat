.PHONY: setup dev build start lint deploy help

# デフォルト: ヘルプを表示
.DEFAULT_GOAL := help

# -----------------------------------------------
# セットアップ
# -----------------------------------------------

## 初回セットアップ（依存パッケージのインストール）
setup:
	npm install

# -----------------------------------------------
# 開発
# -----------------------------------------------

## 開発サーバーを起動（http://localhost:3000）
dev:
	npm run dev

## TypeScript の型チェック
typecheck:
	npx tsc --noEmit

## Lint を実行
lint:
	npm run lint

# -----------------------------------------------
# ビルド
# -----------------------------------------------

## プロダクションビルド
build:
	npm run build

## ビルド後にプロダクションサーバーを起動
start: build
	npm run start

# -----------------------------------------------
# デプロイ
# -----------------------------------------------

## Vercel にデプロイ（プロダクション）
deploy:
	vercel --prod --yes

## Vercel にプレビューデプロイ
deploy-preview:
	vercel --yes

# -----------------------------------------------
# ユーティリティ
# -----------------------------------------------

## 使い方を表示
help:
	@echo ""
	@echo "使い方: make <コマンド>"
	@echo ""
	@echo "コマンド一覧:"
	@grep -E '^## ' Makefile | sed 's/## /  /'
	@echo ""
